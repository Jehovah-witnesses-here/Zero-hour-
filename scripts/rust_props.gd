extends Node3D
## Spawns placeholder props at exact MW2 mp_rust entity positions.
## Positions from mp_rust.map: godot_x=(mw2_x-868)*0.0254, godot_y=(mw2_z+240)*0.0254, godot_z=(1006-mw2_y)*0.0254
## NOTE: Storage tanks are already in the OBJ mesh — do NOT re-spawn them.
## Pipes and corrugated metal ARE separate misc_model entities (NOT brush geometry).


const _TEX_DIR = "res://assets/maps/rust/exported_images/modern_warfare_2/"

func _tex(name: String) -> StandardMaterial3D:
	var mat = StandardMaterial3D.new()
	var path = _TEX_DIR + name
	if ResourceLoader.exists(path):
		mat.albedo_texture = load(path)
	else:
		mat.albedo_color = Color(0.5, 0.5, 0.5)
	return mat


func _ready() -> void:
	_spawn_truck()
	_spawn_pickup_trucks()
	_spawn_helicopter()
	_spawn_barrels()
	#_spawn_storage_tanks() # already in OBJ mesh
	_spawn_boulders()
	_spawn_flags()
	_spawn_concrete_barriers()
	_spawn_gas_station()
	_spawn_propane_tanks()
	_spawn_plastic_cases()
	#_spawn_pipes()      # coupling/fitting models — OBJ has the pipe runs; primitives add noise
	#_spawn_corrugated() # overlap with OBJ brush corrugated walls → z-fighting
	_spawn_small_rocks()
	#_spawn_shrubs() # too many spheres — need real foliage models


func _box(pos: Vector3, size: Vector3, col: Color, rot_y: float = 0.0) -> void:
	var body = StaticBody3D.new()
	body.global_position = pos + Vector3(0, size.y * 0.5, 0)
	body.rotation_degrees.y = rot_y
	var mi = MeshInstance3D.new()
	var mesh = BoxMesh.new()
	mesh.size = size
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mi.mesh = mesh
	mi.material_override = mat
	var cs = CollisionShape3D.new()
	var box = BoxShape3D.new()
	box.size = size
	cs.shape = box
	body.add_child(mi)
	body.add_child(cs)
	add_child(body)


func _cylinder(pos: Vector3, radius: float, height: float, col: Color) -> void:
	var body = StaticBody3D.new()
	body.global_position = pos + Vector3(0, height * 0.5, 0)
	var mi = MeshInstance3D.new()
	var mesh = CylinderMesh.new()
	mesh.top_radius = radius
	mesh.bottom_radius = radius
	mesh.height = height
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mi.mesh = mesh
	mi.material_override = mat
	# MW2 entity origin at center — no y offset
	var cs = CollisionShape3D.new()
	var cyl = CylinderShape3D.new()
	cyl.radius = radius
	cyl.height = height
	cs.shape = cyl
	
	body.add_child(mi)
	body.add_child(cs)
	add_child(body)


func _visual_sphere(pos: Vector3, radius: float, col: Color) -> void:
	# Decorative only — no collision (boulders too small to matter for gameplay)
	var mi = MeshInstance3D.new()
	var mesh = SphereMesh.new()
	mesh.radius = radius
	mesh.height = radius * 1.5
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mi.mesh = mesh
	mi.material_override = mat
	mi.position = pos + Vector3(0, radius * 0.75, 0)
	add_child(mi)


