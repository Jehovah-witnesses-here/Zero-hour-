func _box_tex(pos: Vector3, size: Vector3, tex: String, rot_y: float = 0.0) -> void:
	var body = StaticBody3D.new()
	body.global_position = pos + Vector3(0, size.y * 0.5, 0)
	body.rotation_degrees.y = rot_y
	var mi = MeshInstance3D.new()
	var mesh = BoxMesh.new(); mesh.size = size
	mi.mesh = mesh; mi.material_override = _tex(tex)
	var cs = CollisionShape3D.new()
	var box = BoxShape3D.new(); box.size = size; cs.shape = box
	body.add_child(mi); body.add_child(cs); add_child(body)

func _cylinder_tex(pos: Vector3, radius: float, height: float, tex: String) -> void:
	var body = StaticBody3D.new()
	body.global_position = pos + Vector3(0, height * 0.5, 0)
	var mi = MeshInstance3D.new()
	var mesh = CylinderMesh.new()
	mesh.top_radius = radius; mesh.bottom_radius = radius; mesh.height = height
	mi.mesh = mesh; mi.material_override = _tex(tex)
	var cs = CollisionShape3D.new()
	var cyl = CylinderShape3D.new()
	cyl.radius = radius; cyl.height = height; cs.shape = cyl
	body.add_child(mi); body.add_child(cs); add_child(body)


func _visual_sphere_tex(pos: Vector3, radius: float, tex: String) -> void:
	var mi = MeshInstance3D.new()
	var mesh = SphereMesh.new()
	mesh.radius = radius; mesh.height = radius * 2.0
	mi.mesh = mesh; mi.material_override = _tex(tex)
	mi.position = pos + Vector3(0, radius, 0)
	add_child(mi)

