func _box3(pos: Vector3, size: Vector3, col: Color, rot: Vector3) -> void:
	var body = StaticBody3D.new()
	body.rotation_order = EULER_ORDER_XYZ
	body.global_position = pos
	body.rotation_degrees = Vector3(rot.x, rot.y, -rot.z)
	var mi = MeshInstance3D.new()
	var mesh = BoxMesh.new()
	mesh.size = size
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mi.mesh = mesh
	mi.material_override = mat
	var cs = CollisionShape3D.new()
	var box = BoxShape3D.new()
	box.size = size
	cs.shape = box
	body.add_child(mi)
	body.add_child(cs)
	add_child(body)


func _cyl3(pos: Vector3, radius: float, height: float, col: Color, rot: Vector3) -> void:
	var body = StaticBody3D.new()
	body.rotation_order = EULER_ORDER_XYZ
	body.global_position = pos
	body.rotation_degrees = Vector3(rot.x, rot.y, -rot.z)
	var mi = MeshInstance3D.new()
	var mesh = CylinderMesh.new()
	mesh.top_radius = radius
	mesh.bottom_radius = radius
	mesh.height = height
	var mat = StandardMaterial3D.new()
	mat.albedo_color = col
	mi.mesh = mesh
	mi.material_override = mat
	var cs = CollisionShape3D.new()
	var cyl = CylinderShape3D.new()
	cyl.radius = radius
	cyl.height = height
	cs.shape = cyl
	body.add_child(mi)
	body.add_child(cs)
	add_child(body)


